+#   ADMITOR_RUN_ID   run id tag (default "host")
+#   ADMITOR_FAMILY   family tag (default "deepseek")
+_ADMITOR_LOGGER = None
+_ADMITOR_TRIED = False
+
+
+def _admitor_logger():
+    global _ADMITOR_LOGGER, _ADMITOR_TRIED
+    if _ADMITOR_TRIED:
+        return _ADMITOR_LOGGER
+    _ADMITOR_TRIED = True
+    try:
+        scripts = os.environ.get("ADMITOR_SCRIPTS", os.path.join(".", "scripts"))
