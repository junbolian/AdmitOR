+            sys.path.append(scripts)
+        from runlog import RunLogger
+        _ADMITOR_LOGGER = RunLogger(
+            os.environ.get("ADMITOR_RUNLOG", "runs/host_llm.jsonl"),
+            run_id=os.environ.get("ADMITOR_RUN_ID", "host"),
+            operator=os.environ.get("ADMITOR_OPERATOR", "unknown"),
+        )
+    except Exception:
+        _ADMITOR_LOGGER = None
+    return _ADMITOR_LOGGER
